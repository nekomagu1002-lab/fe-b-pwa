          ]
        },
        {
          "lineIndex": 4,
          "title": "ループ開始 i = 1",
          "note": "i = 1 でループに入ります。",
          "variables": [
            { "name": "i",     "value": "1",                 "changed": true  },
            { "name": "count", "value": "0",                 "changed": false },
            { "name": "data",  "value": "{3, 7, 2, 8, 5, 1}", "changed": false }
          ]
        },
        {
          "lineIndex": 5,
          "title": "条件チェック（i = 1）",
          "note": "data[1] = 3 >= 5 → 条件不成立。count を増やしません。",
          "variables": [
            { "name": "i",     "value": "1",                 "changed": false },
            { "name": "count", "value": "0",                 "changed": false },
            { "name": "data",  "value": "{3, 7, 2, 8, 5, 1}", "changed": false }
