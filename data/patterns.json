            { "name": "count", "value": "未定義",            "changed": false },
            { "name": "data",  "value": "{3, 7, 2, 8, 5, 1}", "changed": true  }
          ]
        },
        {
          "lineIndex": 3,
          "title": "カウンターを初期化",
          "note": "count を 0 でリセットします。数える前は 0 が正しい初期値です。",
