    {
      "id": "p02-count",
      "title": "条件付きカウントパターン",
      "description": "条件を満たす要素の個数を数えます。カウンター変数を 0 で初期化して、条件成立のたびに 1 加算します。",
      "code": [
        "整数型の配列: data[1..6]",
        "整数型: i, count",
        "data ← {3, 7, 2, 8, 5, 1}",
        "count ← 0",
        "for (i を 1 から 6 まで 1 ずつ増やす)",
        "  if (data[i] >= 5)",
        "    count ← count + 1",
        "  endif",
        "endfor",
        "count を出力する"
      ],
      "steps": [
        {
          "lineIndex": 2,
          "title": "配列を代入",
